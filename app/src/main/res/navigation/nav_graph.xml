<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/tasksFragment">

    <fragment
        android:id="@+id/tasksFragment"
        android:name="xavier.pedro.suavez.ui.TasksFragment"
        android:label="Tarefas"
        tools:layout="@layout/fragment_tasks">
        <action
            android:id="@+id/action_tasksFragment_to_taskCreateFragment"
            app:destination="@id/taskCreateFragment" />
    </fragment>

    <fragment
        android:id="@+id/preferencesFragment"
        android:name="xavier.pedro.suavez.ui.PreferencesFragment"
        android:label="Preferências"
        tools:layout="@layout/fragment_preferences" />

    <fragment
        android:id="@+id/scoreboardFragment"
        android:name="xavier.pedro.suavez.ui.ScoreboardFragment"
        android:label="Placar"
        tools:layout="@layout/fragment_scoreboard" />

    <fragment
        android:id="@+id/roommatesFragment"
        android:name="xavier.pedro.suavez.ui.RoommatesFragment"
        android:label="Moradores"
        tools:layout="@layout/fragment_roommates" />

    <fragment
        android:id="@+id/taskCreateFragment"
        android:name="xavier.pedro.suavez.ui.TaskCreateFragment"
        android:label="Cadastro de Tarefa"
        tools:layout="@layout/fragment_task_create" />

</navigation>
