<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sheet_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/tinta"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_mode_chip"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_pill_shape"
                android:backgroundTint="@color/nevoa"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:textColor="@color/verde_fundo"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Nome * -->
        <TextView
            android:id="@+id/tv_label_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_activity_title"
            android:textColor="@color/tinta"
            android:textSize="14sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_activity_title"
            style="@style/Widget.SuaVez.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_activity_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_activity_title_unique"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:minHeight="52dp"
                android:textColor="@color/tinta"
                android:textColorHint="@color/tinta_apagada" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Categoria * -->
        <TextView
            android:id="@+id/tv_label_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_activity_category"
            android:textColor="@color/tinta"
            android:textSize="14sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_limpeza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipCornerRadius="999dp"
                app:chipMinHeight="40dp"
                app:chipStrokeWidth="1.5dp"
                app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_compras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipCornerRadius="999dp"
                app:chipMinHeight="40dp"
                app:chipStrokeWidth="1.5dp"
                app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_contas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipCornerRadius="999dp"
                app:chipMinHeight="40dp"
                app:chipStrokeWidth="1.5dp"
                app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_outras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipCornerRadius="999dp"
                app:chipMinHeight="40dp"
                app:chipStrokeWidth="1.5dp"
                app:ensureMinTouchTargetSize="false" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/tv_error_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/error_activity_category"
            android:textColor="@color/pref_odeio_texto"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Esforço * -->
        <TextView
            android:id="@+id/tv_label_effort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_activity_effort"
            android:textColor="@color/tinta"
            android:textSize="14sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_effort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_effort_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipCornerRadius="999dp"
                app:chipMinHeight="40dp"
                app:chipStrokeWidth="1.5dp"
                app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_effort_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipCornerRadius="999dp"
                app:chipMinHeight="40dp"
                app:chipStrokeWidth="1.5dp"
                app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_effort_heavy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipCornerRadius="999dp"
                app:chipMinHeight="40dp"
                app:chipStrokeWidth="1.5dp"
                app:ensureMinTouchTargetSize="false" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/tv_error_effort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/error_activity_effort"
            android:textColor="@color/pref_odeio_texto"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Recorrência * (somente criação admin) -->
        <LinearLayout
            android:id="@+id/layout_section_recurrence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_label_recurrence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/label_activity_recurrence"
                android:textColor="@color/tinta"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_recurrence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_rec_unica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/option_recurrence_unique"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="999dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeWidth="1.5dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_rec_recorrente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/option_recurrence_recurring"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="999dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeWidth="1.5dp"
                    app:ensureMinTouchTargetSize="false" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tv_error_recurrence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/error_activity_recurrence"
                android:textColor="@color/pref_odeio_texto"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Frequência * -->
        <LinearLayout
            android:id="@+id/layout_section_frequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_label_frequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/label_activity_frequency"
                android:textColor="@color/tinta"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_frequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_freq_diaria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="999dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeWidth="1.5dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_freq_semanal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="999dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeWidth="1.5dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_freq_quinzenal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="999dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeWidth="1.5dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_freq_mensal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="999dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeWidth="1.5dp"
                    app:ensureMinTouchTargetSize="false" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tv_error_frequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/error_activity_frequency"
                android:textColor="@color/pref_odeio_texto"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Abrir atividade na semana atual? * -->
        <LinearLayout
            android:id="@+id/layout_section_open_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_label_open_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/label_activity_open_now"
                android:textColor="@color/tinta"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_open_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_open_now_yes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/option_open_now_yes"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="999dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeWidth="1.5dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_open_now_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/option_open_now_no"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="999dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeWidth="1.5dp"
                    app:ensureMinTouchTargetSize="false" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tv_error_open_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/error_activity_open_now"
                android:textColor="@color/pref_odeio_texto"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Prazo * -->
        <LinearLayout
            android:id="@+id/layout_section_deadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_label_deadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/label_activity_deadline"
                android:textColor="@color/tinta"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_deadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_deadline_hoje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="999dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeWidth="1.5dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_deadline_sabado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="999dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeWidth="1.5dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_deadline_domingo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="999dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeWidth="1.5dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_deadline_sem_prazo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="999dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeWidth="1.5dp"
                    app:ensureMinTouchTargetSize="false" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tv_error_deadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/error_activity_deadline"
                android:textColor="@color/pref_odeio_texto"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_activity"
            style="@style/Widget.SuaVez.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/action_create_activity" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_activity"
            style="@style/Widget.SuaVez.Button.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/action_delete_activity"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_activity"
            style="@style/Widget.SuaVez.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/action_cancel" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
