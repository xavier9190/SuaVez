<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/parede"
    android:orientation="vertical">

    <!-- Sub-barra: Voltar, Título, Criar atividade -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_open_tasks_back"
            android:rotation="180"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/tinta" />

        <TextView
            android:id="@+id/tv_open_tasks_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/open_tasks_title"
            android:textColor="@color/tinta"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/btn_add_activity_top"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_solid"
            android:backgroundTint="@color/nevoa"
            android:contentDescription="@string/cd_create_activity"
            android:src="@drawable/ic_plus"
            app:tint="@color/verde_fundo" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/open_tasks_subtitle"
                android:textColor="@color/tinta_suave"
                android:textSize="14sp" />

            <!-- Estado vazio -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_open_tasks_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/superficie"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/linha"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_suavez_mark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/open_tasks_empty_title"
                        android:textColor="@color/tinta"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/open_tasks_empty_subtitle"
                        android:textColor="@color/tinta_suave"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lista de tarefas abertas -->
            <LinearLayout
                android:id="@+id/ll_open_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Botão tracejado Criar atividade -->
            <LinearLayout
                android:id="@+id/btn_create_activity_dashed"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_dashed_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/verde_fundo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/action_create_activity"
                    android:textColor="@color/verde_fundo"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <!-- Botão Distribuir pendentes (apenas admin) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_distribute_pending"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/open_tasks_distribute_pending"
                android:textAllCaps="false"
                android:textColor="@color/verde_fundo"
                android:visibility="gone"
                app:backgroundTint="@color/nevoa"
                app:cornerRadius="14dp"
                app:rippleColor="@color/verde_casa" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
